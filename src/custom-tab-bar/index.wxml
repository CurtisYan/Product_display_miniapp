<view class="tab-shell">
  <view class="page-nav">
    <view class="page-nav-spectrum"><view/><view/><view/></view>
    <view class="page-nav-cursor" style="transform:translateX({{selected * 100}}%)"/>
    <view class="page-nav-items">
      <view wx:for="{{tabs}}" wx:key="pagePath" class="page-nav-item {{selected === index ? 'page-nav-item--active page-nav-item--' + index : ''}}" data-index="{{index}}" bindtap="switchPage">
        <text class="page-nav-number">{{item.number}}</text><text>{{item.text}}</text>
      </view>
    </view>
  </view>
</view>
