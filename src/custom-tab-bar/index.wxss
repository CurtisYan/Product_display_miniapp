.tab-shell{height:146rpx;background:#f4f0e7;box-sizing:border-box;padding:0 22rpx 38rpx}
.page-nav{position:relative;height:108rpx;border:3rpx solid #20211d;box-sizing:border-box;background:#f4f0e7;box-shadow:8rpx 8rpx 0 rgba(32,33,29,.18);overflow:hidden}
.page-nav-spectrum{position:absolute;z-index:4;left:0;right:0;top:0;height:9rpx;display:flex}
.page-nav-spectrum view{width:33.333%;height:100%}
.page-nav-spectrum view:first-child{background:#ff6b4a}
.page-nav-spectrum view:nth-child(2){background:#f0bd2e}
.page-nav-spectrum view:last-child{background:#37c4aa}
.page-nav-cursor{position:absolute;z-index:1;left:0;top:9rpx;bottom:0;width:33.333%;background:#20211d;transition:transform .42s cubic-bezier(.16,1,.3,1)}
.page-nav-items{position:absolute;z-index:2;left:0;right:0;top:9rpx;bottom:0;display:flex}
.page-nav-item{width:33.333%;display:flex;align-items:center;justify-content:center;border-right:2rpx solid #20211d;box-sizing:border-box;font-size:25rpx;font-weight:800;color:#20211d}
.page-nav-item:last-child{border-right:0}
.page-nav-number{font-size:17rpx;margin-right:10rpx;opacity:.55}
.page-nav-item--active{color:#f4f0e7}
.page-nav-item--active .page-nav-number{opacity:1}
.page-nav-item--0 .page-nav-number{color:#ff6b4a}
.page-nav-item--1 .page-nav-number{color:#f0bd2e}
.page-nav-item--2 .page-nav-number{color:#37c4aa}
